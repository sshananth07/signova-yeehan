# Copy to .env for local runs. Validated at startup by src/config/env.ts.
PORT=8080
GOOGLE_CLOUD_PROJECT=demo-signova
STORAGE_BUCKET=demo-signova.appspot.com
CORS_ORIGINS=http://localhost:5173
# INFERENCE_URL=http://localhost:5000

# Point firebase-admin at the Emulator Suite (backend/firebase.json). Remove in dev/prod.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
